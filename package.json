{
  "name": "bead-loop-portfolio",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write '**/*.{ts,tsx,md}'",
    "lint": "eslint && tsc --noemit && prettier --check '**/*.{ts,tsx,md,scss}'"
  },
  "dependencies": {
    "@mantine/core": "^7.9.1",
    "@mantine/form": "^7.16.3",
    "@mantine/hooks": "^7.16.3",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@tabler/icons-react": "^3.44.0",
    "html-to-image": "^1.11.13",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-draggable": "^4.5.0",
    "react-hot-toast": "^2.6.0",
    "react-router": "^8"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^2.5.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "printWidth": 80
  }
}
