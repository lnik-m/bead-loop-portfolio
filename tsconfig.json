{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "api/*": ["./app/api/*"],
      "actions": ["./app/api/actions"],
      "core/*": ["./app/api/core/*"],
      "middleware": ["./app/api/actions/middleware.ts"],
      "app/*": ["./app/src/app/*"],
      "pages": ["./app/src/pages"],
      "widgets": ["./app/src/widgets"],
      "features/*": ["./app/src/features/*"],
      "shared/*": ["./app/src/shared/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
